# =============================================================
# JA STORE — Variáveis de ambiente
# =============================================================
# Copie este arquivo para ".env" (uso local) e/ou configure as
# mesmas chaves em: Netlify -> Site settings -> Environment variables
# NUNCA suba o arquivo ".env" real para o Git.
# =============================================================

# ---------- SUPABASE ----------
# Painel do projeto -> Settings -> API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=coloque_a_anon_key_aqui
# service_role tem acesso total ao banco — usar SÓ nas funções serverless, nunca no frontend
SUPABASE_SERVICE_ROLE_KEY=coloque_a_service_role_key_aqui

# ---------- MERCADO PAGO ----------
# https://www.mercadopago.com.br/developers/panel/app
MERCADOPAGO_ACCESS_TOKEN=coloque_o_access_token_de_producao_ou_teste

# ---------- MELHOR ENVIO ----------
# https://melhorenvio.com.br -> Gerenciar Tokens de API
MELHORENVIO_TOKEN=coloque_o_token_aqui
# CEP de onde os produtos são enviados (endereço da JA Store)
STORE_ORIGIN_CEP=01001000

# ---------- WHATSAPP (opcional — Meta Cloud API) ----------
# https://developers.facebook.com/docs/whatsapp/cloud-api/get-started
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
STORE_WHATSAPP_NUMBER=5511946790983

# ---------- URL pública do site (usada nos retornos do Mercado Pago) ----------
SITE_URL=https://seu-site.netlify.app
